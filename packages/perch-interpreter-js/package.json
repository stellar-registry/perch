{
  "name": "@stellar-registry/perch-interpreter",
  "version": "0.1.0",
  "description": "TypeScript client bindings for the perch interpreter contract (install/uninstall/enforce + get_program/program_version reads)",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "test": "vitest run",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^17.0.1",
    "buffer": "^6.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.7"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/stellar-registry/perch",
    "directory": "packages/perch-interpreter-js"
  }
}
