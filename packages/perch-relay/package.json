{
  "name": "@stellar-registry/perch-relay",
  "version": "0.1.0",
  "description": "Store-and-forward relay for perch recovery guardian approvals: admits signed submit_guardian/approve_change auth entries only once authenticated, so anyone can collect and submit them",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "perch-relay": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "test": "vitest run",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^17.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.7"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/stellar-registry/perch",
    "directory": "packages/perch-relay"
  }
}
