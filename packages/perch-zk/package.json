{
  "name": "@stellar-registry/perch-zk",
  "version": "0.1.0",
  "description": "Proof helpers for Perch ZK recovery: commitments, Merkle witnesses from pool leaves, a trust-free pool indexer, circuit inputs, and UltraHonk proving in the browser or Node",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./indexer": {
      "types": "./dist/indexer/index.d.ts",
      "import": "./dist/indexer/index.js"
    },
    "./artifacts/*": "./artifacts/*"
  },
  "files": [
    "dist",
    "artifacts"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "test": "vitest run",
    "check": "tsc --noEmit",
    "bench": "npm run build && node bench/prove.mjs"
  },
  "dependencies": {
    "@aztec/bb.js": "0.87.0",
    "@noble/hashes": "^2.2.0",
    "@noir-lang/noir_js": "1.0.0-beta.9"
  },
  "peerDependencies": {
    "@stellar/stellar-sdk": "^17.0.1"
  },
  "peerDependenciesMeta": {
    "@stellar/stellar-sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.7",
    "@stellar/stellar-sdk": "^17.0.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/stellar-registry/perch",
    "directory": "packages/perch-zk"
  }
}
